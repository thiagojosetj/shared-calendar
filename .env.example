# -----------------------------------------------------------------------------
# Shared Calendar — variáveis de ambiente de desenvolvimento
#
# Copie este arquivo para `.env` e ajuste os valores:
#
#     cp .env.example .env
#
# O arquivo `.env` está no .gitignore e NUNCA deve ser versionado.
# Este arquivo (`.env.example`) contém apenas nomes de variáveis e valores fictícios.
# -----------------------------------------------------------------------------

# --- Banco de dados (consumido pelo docker-compose.yml e pelo backend) -------
POSTGRES_DB=shared_calendar
POSTGRES_USER=shared_calendar
# Troque por um valor local qualquer. Não é um segredo de produção, mas também
# não deve ser reaproveitado em nenhum outro lugar.
POSTGRES_PASSWORD=troque-esta-senha-local
# Porta exposta no host, usada também pelo backend para conectar.
# Altere se a 5432 já estiver ocupada na sua máquina.
POSTGRES_PORT=5432
# Host do banco visto pelo backend. O padrão (localhost) serve para o backend rodando na
# máquina; só precisa ser definido se o backend rodar em outro host ou em container.
# DB_HOST=localhost

# --- Backend -----------------------------------------------------------------
# Opcional ao usar `./mvnw spring-boot:run -Dspring-boot.run.profiles=dev`, que já ativa o perfil
# e faz o backend ler este arquivo. Vale quando as variáveis são exportadas no shell.
SPRING_PROFILES_ACTIVE=dev
# URL do frontend em desenvolvimento. Usada para CORS e para o redirecionamento
# após o login com Google.
APP_FRONTEND_URL=http://localhost:5173

# --- Google OAuth2 (Fase 1 / F1-05) ------------------------------------------
# Credenciais obtidas no Google Cloud Console.
# NUNCA preencha valores reais neste arquivo — preencha apenas no `.env`.
GOOGLE_CLIENT_ID=exemplo-cliente.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=exemplo-segredo-nao-use-este-valor
